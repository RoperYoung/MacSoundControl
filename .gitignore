# MacSoundControl's public GitHub repository is distribution-only.
# Ignore everything by default, then explicitly allow the small set of
# documentation and update-feed files that are safe to publish.
*

# Repository landing page and notices.
!.gitignore
!README.md
!README_EN.md
!THIRD_PARTY_NOTICES.md
!使用说明.md

# Public product artwork used by README only.
!Assets/
Assets/*
!Assets/AppIcon.png
!Assets/download-macos-zh.svg
!Assets/download-macos-en.svg

# Human-readable release material.
!Distribution/
Distribution/*
!Distribution/release-notes-*.md
!Distribution/安装说明.txt

# GitHub Pages update feed and README screenshots.
!docs/
docs/*
!docs/appcast.xml
!docs/images/
docs/images/*
!docs/images/*.png
!docs/images/*.jpg
!docs/images/*.jpeg
!docs/images/*.webp
!docs/images/*.gif

# Defense in depth: never publish implementation, build, signing, or secrets.
Sources/
Tests/
scripts/
Build/
DerivedData/
Vendor/
.build/
.swiftpm/

*.swift
*.m
*.mm
*.c
*.cc
*.cpp
*.h
*.hpp
*.plist
*.entitlements
*.xcodeproj/
*.xcworkspace/
Package.swift
Package.resolved
build.sh

*.app
*.dmg
*.zip
*.xcarchive
*.notary.json
*.p12
*.cer
*.key
*.pem
*.mobileprovision
*.provisionprofile
.env
.env.*
.DS_Store
releases/
